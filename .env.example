# Local dev defaults — copy to .env and customise as needed.

# ---- Always set ----
ENVIRONMENT=local
DATABASE_URL=sqlite:///./qr_codes.db
REDIS_URL=redis://localhost:6379/0
SERVER_SECRET=local-dev-secret-change-me

# Auth token for POST /internal/flush_clicks (Cloud Scheduler in production).
# Leave empty in local dev — endpoint will refuse all requests.
INTERNAL_TOKEN=

# ---- Production only (Cloud SQL Python Connector path) ----
# Setting INSTANCE_CONNECTION_NAME activates the Connector branch in app/database.py.
# Leave blank locally; provide via gcloud run --set-env-vars / --set-secrets in production.
# INSTANCE_CONNECTION_NAME=<PROJECT_ID>:asia-east1:qr-db
# DB_USER=qrapp
# DB_PASS=
# DB_NAME=qrdb
# CLOUD_SQL_IP_TYPE=PUBLIC
