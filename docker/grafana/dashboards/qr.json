{
  "title": "QR Code Generator — Observability",
  "uid": "qr-observability",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Redirect QPS (5m)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(qr_redirect_total[5m]))",
          "legendFormat": "QPS"
        }
      ]
    },
    {
      "id": 2,
      "title": "Redirect Rate by Cache Result",
      "type": "timeseries",
      "gridPos": { "x": 4, "y": 0, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "rate(qr_redirect_total{cache_result=\"hit\"}[1m])",
          "legendFormat": "cache hit"
        },
        {
          "expr": "rate(qr_redirect_total{cache_result=\"miss\"}[1m])",
          "legendFormat": "cache miss"
        }
      ]
    },
    {
      "id": 3,
      "title": "Redirect Duration p50/p95/p99",
      "type": "timeseries",
      "gridPos": { "x": 14, "y": 0, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{handler=~\"/r/.*\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{handler=~\"/r/.*\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{handler=~\"/r/.*\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Image Cache Hit Rate (5m)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 4, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "rate(qr_image_cache_total{result=\"hit\"}[5m]) / rate(qr_image_cache_total[5m])",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 5,
      "title": "Click Stream Published vs Consumed",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(qr_click_stream_published_total[1m])",
          "legendFormat": "published/s"
        },
        {
          "expr": "rate(qr_click_stream_consumed_total[1m])",
          "legendFormat": "consumed/s"
        }
      ]
    },
    {
      "id": 6,
      "title": "Click Stream Lag",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "qr_click_stream_lag",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "id": 7,
      "title": "DB Pool In Use",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "qr_db_pool_in_use",
          "legendFormat": "checked out connections"
        }
      ]
    }
  ]
}
